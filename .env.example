# Local secrets — copy values to VPS env as needed
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Optional: override built-in users JSON array
# AUTH_USERS_JSON=

# Required for AI Chat, Voice (Realtime), email drafts, analyst
OPENAI_API_KEY=sk-REPLACE_ME

# Optional model overrides
# OPENAI_CHAT_MODEL=gpt-5.6-terra
# Interactive AI Chat uses FAST by default (lowest latency):
# OPENAI_FAST_MODEL=gpt-5.6-luna
# OPENAI_REALTIME_MODEL=
# OPENAI_REALTIME_FALLBACK_MODEL=

# Product photos from POS Image Dir. (marketplace CDN)
NEXT_PUBLIC_PRODUCT_IMAGE_BASE_URL=https://backend.vallianimarketplace.com/uploads/products
